{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // The design-token source is imported both by the app and by a node script
    // run with --experimental-strip-types, whose ESM resolver requires the
    // extension. Safe here because noEmit is on.
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  // iCloud makes "name 2.ts" conflict copies of generated files faster than a
  // pre-step can delete them, and duplicated .next/types files break the build
  // with spurious redeclaration errors. Excluding them is race-free.
  "exclude": [
    "node_modules",
    "**/* 2.*",
    "**/* 3.*",
    "**/* 4.*",
    "**/* 5.*",
    "**/* 6.*"
  ]
}
