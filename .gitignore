# Parent-level ignores only. The web app keeps its own web/.gitignore, and each
# plugin submodule keeps its own (build/ artefacts live there and are ~400MB each).

.DS_Store
*.pem

# Editor / tooling state
.idea/
.vscode/
.claude/settings.local.json

# iCloud conflict copies. This tree sits under a synced Desktop, and iCloud
# makes "name 2.ext" duplicates of anything a build regenerates.
* [0-9].*
